# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

# --- Google Drive ---
# ID de la carpeta compartida con la cuenta de servicio (está en la URL de Drive).
GOOGLE_DRIVE_FOLDER_ID=
# Ruta al JSON de la cuenta de servicio de Google (para uso local).
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Alternativa para Streamlit Cloud: pegar el contenido completo del JSON como string.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# --- Gemini (LLM de generación) ---
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# --- Pinecone (base de datos vectorial) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mercado-central-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings y reranking (locales, no requieren API key) ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Parámetros de chunking y recuperación ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K_RETRIEVE=20
TOP_K_RERANK=5
MIN_RERANK_SCORE=0.15

# --- Panel de administración de la app ---
ADMIN_PASSWORD=
