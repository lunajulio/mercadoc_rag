# Plantilla de secrets para Streamlit Community Cloud.
# En la app desplegada: Settings -> Secrets -> pegar este contenido con los valores reales.
# NO subir este archivo con valores reales a git (usa .streamlit/secrets.toml localmente si prefieres
# probar el formato TOML, pero ese archivo también está en .gitignore).

GOOGLE_DRIVE_FOLDER_ID = "tu_folder_id_de_drive"

# Pega aquí el contenido COMPLETO del JSON de la cuenta de servicio, como string de una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON = '{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

GEMINI_API_KEY = "tu_api_key_de_gemini"
GEMINI_MODEL_NAME = "gemini-2.5-flash"

PINECONE_API_KEY = "tu_api_key_de_pinecone"
PINECONE_INDEX_NAME = "mercado-central-rag"
PINECONE_CLOUD = "aws"
PINECONE_REGION = "us-east-1"

EMBEDDING_MODEL_NAME = "intfloat/multilingual-e5-small"
RERANKER_MODEL_NAME = "cross-encoder/mmarco-mMiniLMv2-L12-H384-v1"

CHUNK_SIZE = "1200"
CHUNK_OVERLAP = "150"
TOP_K_RETRIEVE = "20"
TOP_K_RERANK = "5"
MIN_RERANK_SCORE = "0.15"

ADMIN_PASSWORD = "elige_una_clave_segura"
